{
  "name": "columnpilot",
  "version": "0.4.1",
  "description": "A lightweight ClickHouse data management console for browsing, querying, and importing data.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --ignore-pattern .next",
    "test": "vitest run",
    "test:compose": "node scripts/compose-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "clickhouse:up": "docker compose up -d clickhouse",
    "clickhouse:down": "docker compose down",
    "clickhouse:logs": "docker compose logs -f clickhouse",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f columnpilot clickhouse"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ipaddr.js": "2.2.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "type": "module"
}
