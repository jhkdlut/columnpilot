# Local Docker ClickHouse configuration.
# Change the password before exposing ClickHouse outside your machine.
CLICKHOUSE_DB=columnpilot
CLICKHOUSE_USER=columnpilot
CLICKHOUSE_PASSWORD=columnpilot_dev
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=19000

# Production builds reject private ClickHouse targets unless this is explicitly enabled.
# Keep false for public/hosted deployments. Use true only on a trusted local network.
COLUMNPILOT_ALLOW_PRIVATE_TARGETS=false
