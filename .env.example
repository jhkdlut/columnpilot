# ColumnPilot web container. The loopback default keeps the console local-only.
COLUMNPILOT_BIND_ADDRESS=127.0.0.1
COLUMNPILOT_PORT=3000
COLUMNPILOT_IMAGE=columnpilot:0.5.0

# Docker ClickHouse configuration.
# Replace this password before allowing access from another machine.
CLICKHOUSE_DB=columnpilot
CLICKHOUSE_USER=columnpilot
CLICKHOUSE_PASSWORD=columnpilot_dev
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=19000

# Standalone production builds reject private ClickHouse targets unless this is enabled.
# Compose enables it inside the trusted, single-operator Docker network so the web
# service can connect to http://clickhouse:8123. Do not enable it for a public
# multi-tenant deployment.
COLUMNPILOT_ALLOW_PRIVATE_TARGETS=false

# Intelligent queries: disabled, mock (deterministic simulation), or http.
# HTTP uses the ColumnPilot protocol described in docs/ai-workspace.md.
COLUMNPILOT_AI_MODE=disabled
COLUMNPILOT_AI_ENDPOINT=
COLUMNPILOT_AI_MODEL=
COLUMNPILOT_AI_API_KEY=
COLUMNPILOT_AI_ALLOW_HTTP=false
# Optional shared random secret; when empty, previews expire on process restart.
COLUMNPILOT_AI_SIGNING_KEY=
